# Copiar a .env (local) o cargar como variables de entorno en Cloudflare.
# Todas son PUBLIC_: acaban en el HTML del navegador, así que ninguna es un
# secreto y ninguna debe serlo.

# Clave de Web3Forms. Sin ella el formulario acepta envíos y los pierde, así
# que el build FALLA a propósito si falta en la plataforma de despliegue.
PUBLIC_WEB3FORMS_KEY=

# --- Medición. Todo lo de abajo es opcional. ---
#
# REGLA DE ORO: si no hay ni PUBLIC_GA4_ID ni PUBLIC_GOOGLE_ADS_ID, el sitio
# no emite una sola línea de Google —ni script, ni dataLayer, ni banner de
# cookies, ni eventos de conversión—. Lo comprueba tests/analitica.test.ts
# contra el build real, así que se puede desplegar sin decidir nada de esto.

# Google Analytics 4. Formato G-XXXXXXXXXX.
PUBLIC_GA4_ID=

# Google Ads. Formato AW-XXXXXXXXX.
#
# Sin esta variable las etiquetas de Ads no se cargan y NINGUNA campaña puede
# medir conversiones, aunque el resto esté bien configurado. Falta el día que
# se empiece a pagar publicidad.
PUBLIC_GOOGLE_ADS_ID=

# Etiqueta de la acción de conversión «formulario enviado», la mitad derecha
# del identificador que Google Ads muestra como AW-123456789/AbC-D_efGhIj:
# aquí va solo el trozo posterior a la barra.
#
# Se obtiene en Google Ads → Objetivos → Conversiones → crear una acción de
# conversión del sitio web → «Instalar la etiqueta manualmente». La conversión
# de /gracias/ solo se emite si esta variable Y PUBLIC_GOOGLE_ADS_ID están
# puestas: con una sola, una conversión a medias no se registra en ningún
# sitio y tampoco da error.
#
# Los clics de WhatsApp y de teléfono NO usan esta variable. Se envían a GA4
# como eventos (clic_whatsapp, clic_telefono) y se importan a Ads desde GA4
# marcándolos como eventos clave, que permite decidir allí cuáles cuentan sin
# volver a tocar el código.
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
