---
import { empresa } from '../../data/empresa';

const enlaces = [
  { texto: 'Servicios', href: '/servicios/' },
  { texto: 'Clientes', href: '/clientes/' },
  { texto: 'Nosotros', href: '/nosotros/' },
  { texto: 'Recursos', href: '/recursos/' },
  { texto: 'Blog', href: '/blog/' },
  { texto: 'Contacto', href: '/contacto/' },
];
const actual = Astro.url.pathname;

// Horario del primer bloque, resumido para la barra superior. Sale de
// empresa.ts como todo lo demás: un solo sitio donde cambiarlo.
const jornada = empresa.horario[0];
---
<!-- Barra de identificación: teléfono, jornada y ubicación antes que nada.
     Para un negocio de servicio local son las tres cosas que un visitante
     busca primero, y el sitio que este reemplaza las tenía enterradas. -->
<div class="zona-oscura bg-noche text-white/70">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-1 px-5 py-2 text-xs">
    <a href={`tel:${empresa.telefonoE164}`} class="cifra font-semibold text-white hover:text-white/80">
      {empresa.telefono}
    </a>
    <span class="cifra">
      Lun a Vie {jornada.abre}–{jornada.cierra}
    </span>
    <span class="ml-auto hidden sm:inline">
      {empresa.direccion.barrio}, {empresa.direccion.ciudad}
    </span>
  </div>
</div>

<!-- Logo y teléfono comparten la primera fila y la navegación va debajo.
     Antes los tres competían por una sola línea que se partía en móvil y
     dejaba el teléfono flotando solo en una tercera fila. Sin JavaScript:
     la jerarquía la da la estructura, no un menú desplegable. -->
<header class="border-b border-borde bg-superficie">
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex items-center justify-between gap-4 py-4">
      <a href="/" class="shrink-0" aria-label={`${empresa.nombre} — inicio`}>
        <img
          src="/logo-mipc.png"
          alt="Logotipo de MiPC Tecnología"
          width="187"
          height="90"
          class="h-10 w-auto"
        />
      </a>

      <a
        href={`tel:${empresa.telefonoE164}`}
        class="cifra shrink-0 rounded-sm bg-senal-fuerte px-4 py-2 text-sm font-semibold text-white hover:bg-senal-oscuro"
      >{empresa.telefono}</a>
    </div>

    <nav
      aria-label="Principal"
      class="-mx-5 flex gap-x-6 overflow-x-auto px-5 pb-3 text-sm lg:mx-0 lg:px-0"
    >
      {enlaces.map((e) => (
        <a
          href={e.href}
          aria-current={actual.startsWith(e.href) ? 'page' : undefined}
          class:list={[
            'whitespace-nowrap py-1 hover:text-senal-oscuro',
            actual.startsWith(e.href) ? 'border-b-2 border-senal font-semibold' : '',
          ]}
        >{e.texto}</a>
      ))}
    </nav>
  </div>
</header>
