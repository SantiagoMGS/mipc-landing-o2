---
/**
 * Banner de consentimiento. Solo existe si hay medición configurada: un
 * banner de cookies en un sitio que no pone cookies es una molestia sin
 * contrapartida, y de esos ya hay bastantes.
 *
 * Se renderiza siempre oculto y lo muestra el script si no hay decisión
 * guardada. Al revés —renderizarlo visible y ocultarlo con JS— provocaría un
 * parpadeo en cada visita de quien ya decidió.
 */
import { hayMedicion } from '../../lib/medicion';
---
{hayMedicion && (
  <>
    <div
      id="banner-cookies"
      hidden
      role="dialog"
      aria-modal="false"
      aria-labelledby="banner-cookies-titulo"
      class="zona-oscura fixed inset-x-0 bottom-0 z-50 border-t-4 border-senal bg-noche text-white/85 shadow-[0_-8px_24px_rgba(0,0,0,0.25)]"
    >
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center">
        <div class="flex-1 text-sm leading-relaxed">
          <h2 id="banner-cookies-titulo" class="font-semibold text-white">Cookies de medición</h2>
          <p class="mt-1">
            Usamos cookies de Google Analytics para saber qué páginas sirven y cuáles no.
            Puedes rechazarlas con un clic y el sitio funciona igual: no hay contenido ni
            formulario que dependa de aceptarlas. Detalle en <a href="/privacidad/" class="underline underline-offset-2 hover:no-underline">política de privacidad</a>.
          </p>
        </div>
        <div class="flex shrink-0 gap-3">
          <button
            type="button"
            id="cookies-rechazar"
            class="rounded-sm border border-white/40 px-4 py-2 text-sm font-semibold text-white hover:bg-white/10"
          >Rechazar</button>
          <button
            type="button"
            id="cookies-aceptar"
            class="rounded-sm bg-senal-fuerte px-4 py-2 text-sm font-semibold text-white hover:bg-senal-oscuro"
          >Entendido</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var CLAVE = 'mipc-consentimiento';
        var VISTAS = 'mipc-aviso-vistas';
        // Cuántas páginas puede ver alguien que ignora el aviso antes de que
        // deje de aparecer. Con el modelo de aviso —la medición ya está
        // activa— insistir no consigue ningún dato que no se tenga: solo
        // molesta. Antes del 2026-08-16 el banner volvía en CADA visita a
        // quien no pulsaba ningún botón, que era la mayoría.
        var MAX_VISTAS = 3;

        var banner = document.getElementById('banner-cookies');
        if (!banner) return;

        function leer(k) {
          try { return localStorage.getItem(k); } catch (e) { return null; }
        }
        function guardar(k, v) {
          try { localStorage.setItem(k, v); } catch (e) { /* modo privado */ }
        }

        /*
         * El aviso tapaba por completo el botón flotante de WhatsApp: los dos
         * van anclados abajo y el aviso está en z-50 contra el z-40 del botón.
         * Siendo el flotante lo más pulsado en móvil, la vía de contacto más
         * usada quedaba oculta durante las tres primeras páginas de cada
         * visitante nuevo.
         *
         * Se publica la altura real del aviso en una variable CSS y global.css
         * sube el botón por encima. La altura se MIDE en vez de fijarse porque
         * en móvil el texto ocupa más líneas y el aviso crece; una constante
         * habría cuadrado en un solo tamaño de pantalla.
         */
        var raiz = document.documentElement;
        function ajustarFlotante() {
          raiz.style.setProperty('--alto-aviso', banner.offsetHeight + 'px');
        }

        // Con decisión tomada —cualquiera de las dos— el aviso no vuelve.
        if (!leer(CLAVE)) {
          var vistas = parseInt(leer(VISTAS) || '0', 10) || 0;
          if (vistas < MAX_VISTAS) {
            banner.hidden = false;
            // Después de quitar `hidden`: con el elemento oculto, offsetHeight
            // es 0 y el botón no se movería.
            ajustarFlotante();
            raiz.classList.add('aviso-cookies-visible');
            // Al rotar el móvil o cambiar el ancho, el texto se recompone y el
            // aviso cambia de alto.
            window.addEventListener('resize', ajustarFlotante);
            guardar(VISTAS, String(vistas + 1));
          }
        }

        function decidir(valor) {
          guardar(CLAVE, valor);
          banner.hidden = true;
          // El botón vuelve a su sitio de siempre.
          raiz.classList.remove('aviso-cookies-visible');
          window.removeEventListener('resize', ajustarFlotante);
          // Solo el rechazo mueve el consentimiento: aceptar ya es el estado
          // por defecto desde Analitica.astro, y volver a concederlo sería una
          // llamada sin efecto.
          if (valor === 'rechazado' && typeof gtag === 'function') {
            gtag('consent', 'update', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
            });
          }
        }

        document.getElementById('cookies-aceptar').addEventListener('click', function () { decidir('aceptado'); });
        document.getElementById('cookies-rechazar').addEventListener('click', function () { decidir('rechazado'); });
      })();
    </script>
  </>
)}
