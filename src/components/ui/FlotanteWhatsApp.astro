---
import { enlaceWhatsApp } from '../../lib/whatsapp';

/**
 * Acceso permanente a WhatsApp. El sitio de WordPress que este reemplaza lo
 * tenía, era su elemento mejor resuelto, y la primera versión de esta
 * reconstrucción lo perdió: WhatsApp es el canal por el que esta empresa
 * recibe la mayoría de sus contactos.
 *
 * El verde es el de la plataforma, deliberadamente fuera de la paleta del
 * sitio: aquí el reconocimiento inmediato vale más que la coherencia
 * cromática. Mide 6,2:1 con su texto oscuro.
 */
interface Props {
  /**
   * Mensaje precargado. Lo pasa `Base.astro` desde cada plantilla; el valor
   * por omisión es para las páginas que no tienen un contexto más concreto
   * (inicio, nosotros, proyectos).
   *
   * Hasta el 2026-08-16 era una constante fija con este mismo texto y NO se
   * podía cambiar por página. En la página de reparación de computadores eso
   * significaba que un particular con el portátil roto abría WhatsApp y se
   * encontraba escrito «para mi empresa»: siendo el flotante el elemento más
   * pulsado en móvil, era la fuga de conversión más cara del sitio.
   */
  mensaje?: string;
}
const { mensaje = 'Hola, quiero consultar por un servicio para mi empresa' } = Astro.props;
---
<a
  href={enlaceWhatsApp(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class="flotante-whatsapp fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 rounded-full bg-[#25d366] px-4 py-3 text-sm font-semibold text-[#0b3d24] shadow-lg transition-transform hover:scale-105 sm:px-5"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 flex-none" fill="currentColor">
    <path d="M12.04 2A9.9 9.9 0 0 0 2.13 11.9a9.8 9.8 0 0 0 1.36 4.98L2 22l5.28-1.44a9.9 9.9 0 0 0 4.76 1.21h.01a9.9 9.9 0 0 0 9.9-9.9A9.9 9.9 0 0 0 12.04 2Zm5.79 14.05c-.24.68-1.4 1.3-1.94 1.34-.5.05-.98.24-3.3-.69-2.78-1.1-4.55-3.94-4.69-4.12-.13-.18-1.12-1.49-1.12-2.84 0-1.35.71-2.02.96-2.29a1 1 0 0 1 .73-.34h.52c.17 0 .4-.06.62.47.24.57.8 1.98.87 2.12.07.14.12.3.02.49-.1.18-.15.29-.29.45-.14.16-.3.36-.43.48-.14.14-.29.3-.13.58.17.28.74 1.21 1.58 1.96 1.09.97 2 1.27 2.29 1.41.28.14.45.12.61-.07.17-.2.7-.82.89-1.1.19-.28.37-.23.62-.14.25.09 1.6.76 1.87.9.28.14.46.21.53.32.07.12.07.66-.17 1.34Z"/>
  </svg>
  <span class="hidden sm:inline">Escríbenos</span>
  <span class="sr-only sm:hidden">Escríbenos por WhatsApp</span>
</a>
