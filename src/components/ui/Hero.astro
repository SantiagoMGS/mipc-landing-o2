---
import { Image } from 'astro:assets';
import Marcador from './Marcador.astro';
import Etiqueta from './Etiqueta.astro';
import Boton from './Boton.astro';
import { empresa } from '../../data/empresa';
// Panorámica real 1600x720: es la única foto del archivo cuya proporción
// nativa corresponde a una banda ancha. Forzar aquí una foto vertical
// obligaba a recortar hasta perder al sujeto.
import foto from '../../assets/fotos/equipo-fachada-alturas.jpg';

interface Props {
  cifras: Array<{ valor: string; etiqueta: string }>;
}
const { cifras } = Astro.props;
---
<section class="zona-oscura relative isolate overflow-hidden bg-noche">
  <Image
    src={foto}
    alt="Dos técnicos de MiPC Tecnología con casco y arnés de seguridad trabajan sobre escaleras en la fachada de una edificación industrial, instalando canalización a media altura"
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="foto-campo absolute inset-0 -z-10 h-full w-full object-cover [object-position:50%_38%]"
  />
  <div class="velo-campo absolute inset-0 -z-10"></div>

  <div class="mx-auto flex max-w-6xl flex-col justify-end px-5 pb-10 pt-28 sm:pt-40 lg:min-h-[38rem] lg:pb-14">
    <Marcador texto={`${empresa.direccion.ciudad} y área metropolitana · desde ${empresa.fundacion}`} tono="claro" />

    <h1 class="titular-mayor mt-5 max-w-3xl text-4xl font-semibold text-white sm:text-5xl lg:text-6xl">
      La tecnología de tu empresa, funcionando todos los días
    </h1>

    <p class="mt-5 max-w-xl text-lg text-white/75">
      Soporte TI, redes de datos, cámaras de seguridad y alquiler de equipos para
      organizaciones que no se pueden dar el lujo de parar.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Boton href="/servicios/">Soy empresa</Boton>
      <Boton href="/servicios/reparacion-de-computadores/" variante="claro">Soy persona</Boton>
    </div>
  </div>

  {/* Riel de etiquetas: las cifras se apoyan en el borde inferior del hero
      como los rótulos impresos de un panel, separadas del contenido por la
      misma línea que en el mundo real separa el equipo de su identificación. */}
  <div class="border-t border-white/15 bg-noche/80 backdrop-blur-sm">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-5 py-6 sm:grid-cols-3 sm:gap-8">
      {cifras.map((c) => <Etiqueta valor={c.valor} etiqueta={c.etiqueta} tono="claro" />)}
    </div>
  </div>
</section>
