---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Boton from '../components/ui/Boton.astro';
import CTAWhatsApp from '../components/ui/CTAWhatsApp.astro';
import Figura from '../components/ui/Figura.astro';
import { service, breadcrumb } from '../lib/jsonld';
import { fotosPorServicio } from '../data/fotos-servicios';
import { fotosPorProyecto } from '../data/fotos-proyectos';

/** Derivado de la colección, no una forma suelta: si el esquema cambia, esto rompe. */
type FAQ = CollectionEntry<'servicios'>['data']['faq'][number];

const { entrada } = Astro.props;
const d = entrada.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const fotos = fotosPorServicio[entrada.id] ?? [];

/**
 * Un solo mensaje de WhatsApp por página, usado tanto por el CTA del
 * encabezado como por el botón flotante. Antes divergían: el CTA decía el
 * servicio y el flotante decía «para mi empresa» en todas partes.
 */
const mensajeWhatsApp = d.mensajeWhatsApp ?? `Hola, me interesa el servicio de ${d.titulo}`;

/**
 * Proyectos que declararon este servicio en su frontmatter.
 *
 * El enlace existía en un solo sentido: los proyectos enlazan al servicio y el
 * servicio no devolvía nada. Nueve proyectos apuntaban a `/servicios/
 * redes-de-datos/` y esa página no tenía una sola ruta hacia la obra que la
 * respalda. Para quien lee, era una promesa sin prueba; para un buscador, un
 * grupo temático a medio construir.
 *
 * La relación ya estaba en los datos —`proyecto.servicios`, que
 * tests/proyectos.test.ts valida contra los slugs reales—, solo que no se
 * pintaba. Esto no inventa nada: recorre lo que ya estaba declarado.
 */
const relacionados = (await getCollection('proyectos'))
  .filter((p) => p.data.servicios.includes(entrada.id))
  .sort((a, b) => a.data.orden - b.data.orden);

const jsonld = [
  service({ nombre: d.titulo, descripcion: d.metaDescription, url, oferta: d.oferta }),
  breadcrumb([
    { nombre: 'Inicio', url: new URL('/', Astro.site).href },
    { nombre: 'Servicios', url: new URL('/servicios/', Astro.site).href },
    { nombre: d.titulo, url },
  ]),
  ...(d.faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faq.map((f: FAQ) => ({
          '@type': 'Question',
          name: f.pregunta,
          acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
        })),
      }]
    : []),
];
---
<Base title={d.metaTitle} metaDescription={d.metaDescription} {jsonld} {mensajeWhatsApp}>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <nav aria-label="Ruta" class="cifra text-xs uppercase tracking-widest text-tinta-2">
      <a href="/" class="hover:text-senal-oscuro">Inicio</a> /
      <a href="/servicios/" class="hover:text-senal-oscuro">Servicios</a> / {d.titulo}
    </nav>

    <h1 class="mt-4 text-4xl font-semibold">{d.h1}</h1>
    <p class="mt-4 text-lg text-tinta-2">{d.resumen}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Boton href="/contacto/">Solicitar cotización</Boton>
      <CTAWhatsApp mensaje={mensajeWhatsApp} />
    </div>

    {d.beneficios.length > 0 && (
      <ul class="mt-12 grid gap-3 sm:grid-cols-2">
        {d.beneficios.map((b: string) => (
          <li class="border border-borde border-l-4 border-l-senal bg-superficie p-4 text-sm">{b}</li>
        ))}
      </ul>
    )}

    {fotos.length > 0 && (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {fotos.map((f) => <Figura src={f.src} alt={f.alt} pie={f.pie} />)}
      </div>
    )}

    <div class="prose prose-neutral mt-12 max-w-none"><slot /></div>

    {relacionados.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-semibold">Obra ejecutada con este servicio</h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {relacionados.map((p) => {
            const foto = fotosPorProyecto[p.id]?.[0];
            return (
              <li>
                <a
                  href={`/proyectos/${p.id}/`}
                  class="canto group flex h-full flex-col overflow-hidden bg-acero transition-colors hover:bg-[#1c303a]"
                >
                  {foto && (
                    <div class="aspect-[4/3] overflow-hidden">
                      <Image
                        src={foto.src}
                        alt={foto.alt}
                        widths={[400, 800]}
                        sizes="(max-width: 640px) 100vw, 340px"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col gap-2 p-5">
                    <span class="cifra text-[0.6875rem] uppercase tracking-[0.16em] text-white/50">
                      {p.data.sector} · {p.data.anio}
                    </span>
                    <h3 class="text-lg font-semibold text-white">{p.data.cliente}</h3>
                    <p class="text-sm leading-relaxed text-white/70">{p.data.titulo}</p>
                    <p class="cifra mt-auto pt-2 text-xs text-white/50">{p.data.lugar}</p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {d.faq.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-semibold">Preguntas frecuentes</h2>
        <dl class="mt-6 space-y-6">
          {d.faq.map((f: FAQ) => (
            <div class="border-t border-borde pt-4">
              <dt class="font-semibold">{f.pregunta}</dt>
              <dd class="mt-2 text-tinta-2">{f.respuesta}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </article>
</Base>
