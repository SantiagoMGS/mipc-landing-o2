---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/ui/Hero.astro';
import Segmentacion from '../components/ui/Segmentacion.astro';
import Marcador from '../components/ui/Marcador.astro';
import MuroClientes from '../components/ui/MuroClientes.astro';
import TarjetaServicio from '../components/ui/TarjetaServicio.astro';
import { formatearFecha } from '../lib/fecha';
import { empresa } from '../data/empresa';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const clientes = await getCollection('clientes');
const entradas = (await getCollection('blog'))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

// Los años y los municipios se derivan de los datos, nunca se escriben: el
// año que viene siguen siendo correctas sin que nadie tenga que acordarse.
//
// «Empresas atendidas» es la excepción y sale de empresa.ts. Antes usaba
// `clientes.length`, que son los 18 clientes con ficha —los que tienen
// logotipo y permiso para nombrarlos—, no las empresas atendidas desde 2009,
// que superan las setenta. Era una cifra exacta que respondía a otra pregunta
// y subestimaba el negocio en un factor de casi cuatro. El razonamiento
// completo está junto al dato.
const anios = new Date().getFullYear() - empresa.fundacion;
const cifras = [
  { valor: `${anios}+`, etiqueta: 'años de experiencia' },
  { valor: `${empresa.empresasAtendidas}+`, etiqueta: 'empresas atendidas' },
  { valor: String(empresa.zonaServicio.length), etiqueta: 'municipios cubiertos' },
];
---
<Base
  title="Soporte TI Empresarial en Medellín | MiPC Tecnología"
  metaDescription="Soporte TI, redes de datos, CCTV y alquiler de equipos para empresas en Medellín. Atendemos emisoras, IPS e instituciones educativas desde 2009."
>
  <Hero {cifras} />

  <MuroClientes />

  <section class="zona-oscura bg-noche">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <Marcador texto="Líneas de servicio" tono="claro" />
      <h2 class="mt-4 max-w-2xl text-3xl font-semibold text-white sm:text-4xl">
        Qué hacemos
      </h2>
      <p class="mt-3 max-w-xl text-white/65">
        Cinco frentes para que la operación no dependa de que nada falle nunca,
        sino de que alguien responda cuando falle.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {servicios.map((s) => <TarjetaServicio servicio={s} />)}
      </div>
    </div>
  </section>

  <Segmentacion />

  {entradas.length > 0 && (
  <section class="bg-fondo">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <Marcador texto="Actualidad" />
      <h2 class="mt-4 text-3xl font-semibold">Lo que conviene saber antes de contratar</h2>

      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {entradas.map((e) => (
          <li class="canto bg-superficie p-6">
            <time datetime={e.data.fecha.toISOString()} class="cifra text-[0.6875rem] uppercase tracking-[0.16em] text-tinta-2">
              {formatearFecha(e.data.fecha)}
            </time>
            <h3 class="mt-2 text-lg font-semibold leading-snug">
              <a href={`/blog/${e.id}/`} class="hover:text-senal-oscuro">{e.data.titulo}</a>
            </h3>
            <p class="mt-2 text-sm text-tinta-2">{e.data.resumen}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}
</Base>
